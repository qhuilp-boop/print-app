        /**
         * Universal 300 DPI Card Extractor that works for:
         * 1. Current active editor state (Rect Cropper OR 4-Point Perspective)
         * 2. Arbitrary BBox or 4-Corners passed by the Smart Auto-Detector
         */
        function extractEnhancedCroppedCard() {
            return extractCardFromBBoxOrCorners({
                mode: editorMode,
                bbox: cropper ? cropper.getData() : null,
                corners: perspectiveCorners
            });
        }

        function extractCardFromBBoxOrCorners(options = {}) {
            if (!currentImageElement) {
                showToast('يرجى رفع صورة مستمسك أولاً!', 'error');
                return null;
            }

            const pxPerMM = 300 / 25.4;
            const targetWidthPx = Math.round(activeCardSpec.widthMM * pxPerMM);
            const targetHeightPx = Math.round(activeCardSpec.heightMM * pxPerMM);

            let rawCanvas = null;
            const useMode = options.mode || editorMode;

            if (useMode === 'perspective' && options.corners) {
                rawCanvas = warpPerspectiveFrom4Corners(currentImageElement, options.corners, targetWidthPx, targetHeightPx);
            } else if (options.bbox && (!cropper || options.bbox !== cropper.getData())) {
                // Direct extraction from image bounding box (used during multi-card auto-capture)
                rawCanvas = document.createElement('canvas');
                rawCanvas.width = targetWidthPx;
                rawCanvas.height = targetHeightPx;
                const rCtx = rawCanvas.getContext('2d');
                rCtx.fillStyle = '#ffffff';
                rCtx.fillRect(0, 0, targetWidthPx, targetHeightPx);
                rCtx.drawImage(
                    currentImageElement,
                    options.bbox.x, options.bbox.y, options.bbox.width, options.bbox.height,
                    0, 0, targetWidthPx, targetHeightPx
                );
            } else if (cropper) {
                rawCanvas = cropper.getCroppedCanvas({
                    width: targetWidthPx,
                    height: targetHeightPx,
                    imageSmoothingEnabled: true,
                    imageSmoothingQuality: 'high',
                    fillColor: '#ffffff'
                });
            }

            if (!rawCanvas) return null;

            const outCanvas = document.createElement('canvas');
            outCanvas.width = rawCanvas.width;
            outCanvas.height = rawCanvas.height;
            const ctx = outCanvas.getContext('2d');

            const isGray = (filterState.mode === 'grayscale' || filterState.mode === 'photocopy');
            ctx.filter = `${isGray ? 'grayscale(100%)' : ''} brightness(${filterState.brightness}%) contrast(${filterState.contrast}%)`;
            ctx.drawImage(rawCanvas, 0, 0);
            ctx.filter = 'none';

            if (filterState.whiten > 0 || filterState.mode === 'photocopy') {
                const imgData = ctx.getImageData(0, 0, outCanvas.width, outCanvas.height);
                const data = imgData.data;
                const whiteThreshold = 252 - Math.round((filterState.whiten / 100) * 65);

                for (let i = 0; i < data.length; i += 4) {
                    const r = data[i], g = data[i + 1], b = data[i + 2];
                    const luminance = 0.299 * r + 0.587 * g + 0.114 * b;

                    if (luminance >= whiteThreshold) {
                        data[i] = 255; data[i + 1] = 255; data[i + 2] = 255;
                    } else if (filterState.mode === 'photocopy' && luminance < 95) {
                        data[i] = Math.max(0, r * 0.82);
                        data[i + 1] = Math.max(0, g * 0.82);
                        data[i + 2] = Math.max(0, b * 0.82);
                    }
                }
                ctx.putImageData(imgData, 0, 0);
            }

            if (filterState.sharpness > 15) {
                applySharpenFilter(ctx, outCanvas.width, outCanvas.height, (filterState.sharpness / 100) * 0.45);
            }

            return {
                dataUrl: outCanvas.toDataURL('image/jpeg', 0.96),
                widthMM: activeCardSpec.widthMM,
                heightMM: activeCardSpec.heightMM,
                sourceMeta: {
                    imgSrc: currentUploadedImgSrc,
                    mode: useMode,
                    cropData: options.bbox ? JSON.parse(JSON.stringify(options.bbox)) : (cropper ? cropper.getData() : null),
                    corners: JSON.parse(JSON.stringify(options.corners || perspectiveCorners))
                }
            };
        }

        function applySharpenFilter(ctx, w, h, mix) {
            const srcData = ctx.getImageData(0, 0, w, h);
            const dstData = ctx.createImageData(w, h);
            const src = srcData.data;
            const dst = dstData.data;

            for (let y = 1; y < h - 1; y++) {
                for (let x = 1; x < w - 1; x++) {
                    const idx = (y * w + x) * 4;
                    for (let c = 0; c < 3; c++) {
                        const center = src[idx + c] * 5;
                        const neighbors =
                            src[((y - 1) * w + x) * 4 + c] +
                            src[((y + 1) * w + x) * 4 + c] +
                            src[(y * w + (x - 1)) * 4 + c] +
                            src[(y * w + (x + 1)) * 4 + c];
                        const sharpened = center - neighbors;
                        dst[idx + c] = Math.min(255, Math.max(0, src[idx + c] * (1 - mix) + sharpened * mix));
                    }
                    dst[idx + 3] = 255;
                }
            }
            ctx.putImageData(dstData, 0, 0);
        }

        // ==========================================
        // 9. STAGING AREA & MANUAL CORRECTION / LIVE SYNC ENGINE
        // ==========================================
        function setStagingSlotData(slot, result) {
            stagingCards[slot] = result;
            const previewContainer = document.getElementById(`staging-${slot}-preview`);
            const clearBtn = document.getElementById(`clear-${slot}-btn`);
            const editBtn = document.getElementById(`edit-${slot}-btn`);

            previewContainer.innerHTML = `
                <img src="${result.dataUrl}" class="w-full h-full object-contain" alt="${slot}">
                <div class="absolute inset-0 bg-slate-900/50 opacity-0 group-hover:opacity-100 transition flex items-center justify-center">
                    <span class="bg-amber-400 text-slate-950 text-xs font-bold px-3 py-1.5 rounded-xl shadow flex items-center gap-1.5">
                        <i class="fa-solid fa-pen-ruler"></i>
                        <span>اضغط لتعديل القص يدوياً</span>
                    </span>
                </div>
            `;
            clearBtn.classList.remove('hidden');
            editBtn.classList.remove('hidden');
        }

        function captureToStaging(slot, syncToA4 = false) {
            const result = extractEnhancedCroppedCard();
            if (!result) return;

            setStagingSlotData(slot, result);
            if (syncToA4) {
                syncStagingSlotToA4(slot, false);
            }

            const labelAr = slot === 'front' ? 'وجه البطاقة' : 'ظهر البطاقة';
            showToast(`تم التقاط وتحديث (${labelAr}) بنجاح!`, 'success');
        }

        /**
         * Ensures the A4 sheet has the latest version of a staged slot (or adds it if not present yet)
         */
        function syncStagingSlotToA4(slot, addIfMissing = true) {
            const cardData = stagingCards[slot];
            if (!cardData) return;

            const labelAr = slot === 'front' ? 'الوجه' : 'الظهر';
            let updatedAny = false;

            a4CardsList.forEach(item => {
                if (item.slotRef === slot) {
                    item.dataUrl = cardData.dataUrl;
                    item.widthMM = cardData.widthMM;
                    item.heightMM = cardData.heightMM;
                    item.sourceMeta = cardData.sourceMeta;
                    updatedAny = true;
                }
            });

            if (!updatedAny && addIfMissing) {
                a4CardsList.push({
                    id: 'card_' + Date.now() + '_' + slot + '_' + Math.random().toString(36).slice(2, 6),
                    slotRef: slot,
                    dataUrl: cardData.dataUrl,
                    label: labelAr,
                    widthMM: cardData.widthMM,
                    heightMM: cardData.heightMM,
                    sourceMeta: cardData.sourceMeta
                });
            }

            renderA4Sheet();
        }

        /**
         * Opens a previously captured card (from Front/Back staging or directly from A4 sheet)
         * in the interactive editor so the user can fine-tune its crop or 4 corners manually with Live Sync!
         */
        function editStagingSlotCrop(slot) {
            const card = stagingCards[slot];
            if (!card || !card.sourceMeta) return;

            activeManualEditTarget = { type: 'staging', targetKey: slot };
            highlightActiveEditingElements();

            const slotAr = slot === 'front' ? 'وجه البطاقة (الأمام)' : 'ظهر البطاقة (الخلف)';
            openSourceMetaInEditor(card.sourceMeta, `جاري تعديل (${slotAr}) — حرك إطار القص أو الزوايا وسيتم تحديث الورقة فوراً`);
        }

        function editA4CardCrop(cardId) {
            const card = a4CardsList.find(c => c.id === cardId);
            if (!card || !card.sourceMeta) return;

            activeManualEditTarget = { type: 'a4', targetKey: cardId, slotRef: card.slotRef };
            highlightActiveEditingElements();

            openSourceMetaInEditor(card.sourceMeta, `جاري تعديل (${card.label}) في ورقة A4 — عدّل الحواف أو الزوايا للتحديث الفوري`);
        }

        function openSourceMetaInEditor(meta, bannerTitle) {
            const banner = document.getElementById('live-edit-banner');
            const titleEl = document.getElementById('live-edit-title');
            banner.classList.remove('hidden');
            titleEl.textContent = bannerTitle;

            const restorePosition = () => {
                if (meta.corners) {
                    perspectiveCorners = JSON.parse(JSON.stringify(meta.corners));
                }
                switchEditorMode(meta.mode || 'rect');
                if (meta.mode === 'perspective') {
                    renderPerspectiveEditorCanvas();
                } else if (cropper && meta.cropData) {
                    cropper.setData(meta.cropData);
                }
            };

            if (currentUploadedImgSrc !== meta.imgSrc) {
                currentUploadedImgSrc = meta.imgSrc;
                const offImg = new Image();
                offImg.onload = () => {
                    currentImageElement = offImg;
                    initCropperInstance(meta.imgSrc, restorePosition);
                };
                offImg.src = meta.imgSrc;
            } else {
                restorePosition();
            }

            // Smooth scroll to editor on smaller screens
            document.getElementById('cropper-dropzone').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            showToast('تم فتح البطاقة للتعديل اليدوي! حرك الإطار أو الزوايا لتصحيح القص.', 'info');
        }

        function syncActiveManualEditLive() {
            if (!activeManualEditTarget) return;
            const updated = extractEnhancedCroppedCard();
            if (!updated) return;

            if (activeManualEditTarget.type === 'staging') {
                const slot = activeManualEditTarget.targetKey;
                setStagingSlotData(slot, updated);
                syncStagingSlotToA4(slot, false);
            } else if (activeManualEditTarget.type === 'a4') {
                const card = a4CardsList.find(c => c.id === activeManualEditTarget.targetKey);
                if (card) {
                    card.dataUrl = updated.dataUrl;
                    card.widthMM = updated.widthMM;
                    card.heightMM = updated.heightMM;
                    card.sourceMeta = updated.sourceMeta;
                }
                if (activeManualEditTarget.slotRef && stagingCards[activeManualEditTarget.slotRef]) {
                    setStagingSlotData(activeManualEditTarget.slotRef, updated);
                }
                renderA4Sheet();
            }
        }

        function applyManualEditAndFinish() {
            if (activeManualEditTarget) {
                syncActiveManualEditLive();
                cancelManualEditMode();
                showToast('تم حفظ التعديل اليدوي وتحديث البطاقة على ورقة A4 بنجاح!', 'success');
            } else {
                // If not in explicit edit mode, update Front or active slot
                captureToStaging('front', true);
            }
        }

        function cancelManualEditMode() {
            activeManualEditTarget = null;
            document.getElementById('live-edit-banner').classList.add('hidden');
            highlightActiveEditingElements();
        }

        function highlightActiveEditingElements() {
            const frontBox = document.getElementById('staging-card-box-front');
            const backBox = document.getElementById('staging-card-box-back');
            frontBox.classList.remove('editing-active-ring');
            backBox.classList.remove('editing-active-ring');

            if (activeManualEditTarget?.type === 'staging') {
                if (activeManualEditTarget.targetKey === 'front') frontBox.classList.add('editing-active-ring');
                if (activeManualEditTarget.targetKey === 'back') backBox.classList.add('editing-active-ring');
            }
            renderA4Sheet();
        }

        function clearStagingSlot(slot) {
            stagingCards[slot] = null;
            const previewContainer = document.getElementById(`staging-${slot}-preview`);
            const clearBtn = document.getElementById(`clear-${slot}-btn`);
            const editBtn = document.getElementById(`edit-${slot}-btn`);

            if (slot === 'front') {
                previewContainer.innerHTML = `
                    <i class="fa-regular fa-id-badge text-2xl text-slate-300 mb-1"></i>
                    <span class="text-[11px] text-slate-400">يتم التقاط الوجه تلقائياً أو يدوياً</span>
                `;
            } else {
                previewContainer.innerHTML = `
                    <i class="fa-solid fa-barcode text-2xl text-slate-300 mb-1"></i>
                    <span class="text-[11px] text-slate-400">يتم التقاط الظهر تلقائياً أو يدوياً</span>
                `;
            }
            clearBtn.classList.add('hidden');
            editBtn.classList.add('hidden');
        }

        function adjustCopies(delta) {
            const input = document.getElementById('copies-count');
            let val = parseInt(input.value, 10) || 1;
            val = Math.min(10, Math.max(1, val + delta));
            input.value = val;
        }

        function commitStagingToA4() {
            if (!stagingCards.front && !stagingCards.back) {
                const autoCrop = extractEnhancedCroppedCard();
                if (!autoCrop) return;
                setStagingSlotData('front', autoCrop);
            }

            const copies = Math.min(10, Math.max(1, parseInt(document.getElementById('copies-count').value, 10) || 1));

            for (let i = 0; i < copies; i++) {
                if (stagingCards.front) {
                    a4CardsList.push({
                        id: 'card_' + Date.now() + '_f_' + i + '_' + Math.random().toString(36).slice(2, 6),
                        slotRef: 'front',
                        dataUrl: stagingCards.front.dataUrl,
                        label: 'الوجه',
                        widthMM: stagingCards.front.widthMM,
                        heightMM: stagingCards.front.heightMM,
                        sourceMeta: stagingCards.front.sourceMeta
                    });
                }
                if (stagingCards.back) {
                    a4CardsList.push({
                        id: 'card_' + Date.now() + '_b_' + i + '_' + Math.random().toString(36).slice(2, 6),
                        slotRef: 'back',
                        dataUrl: stagingCards.back.dataUrl,
                        label: 'الظهر',
                        widthMM: stagingCards.back.widthMM,
                        heightMM: stagingCards.back.heightMM,
                        sourceMeta: stagingCards.back.sourceMeta
                    });
                }
            }

            renderA4Sheet();
            showToast(`تمت إضافة المستمسك (${copies} نسخة) إلى ورقة الطباعة A4!`, 'success');
        }

        function addCurrentCropDirectlyToA4() {
            const cropped = extractEnhancedCroppedCard();
            if (!cropped) return;

            a4CardsList.push({
                id: 'card_' + Date.now() + '_' + Math.random().toString(36).slice(2, 6),
                slotRef: null,
                dataUrl: cropped.dataUrl,
                label: 'بطاقة',
                widthMM: cropped.widthMM,
                heightMM: cropped.heightMM,
                sourceMeta: cropped.sourceMeta
            });

            renderA4Sheet();
            showToast('تمت إضافة البطاقة المقصوصة مباشرة إلى ورقة A4', 'success');
        }

        // ==========================================
        // 10. A4 SHEET LAYOUT & MANAGEMENT
        // ==========================================
        function renderA4Sheet() {
            const grid = document.getElementById('a4-cards-grid');
            const emptyOverlay = document.getElementById('a4-empty-overlay');
            const counterBadge = document.getElementById('a4-counter-badge');

            grid.innerHTML = '';
            counterBadge.textContent = `${a4CardsList.length} بطاقات`;

            if (a4CardsList.length === 0) {
                emptyOverlay.classList.remove('hidden');
                return;
            }
            emptyOverlay.classList.add('hidden');

            a4CardsList.forEach((card, index) => {
                const slot = document.createElement('div');
                const isBeingEdited = (activeManualEditTarget?.type === 'a4' && activeManualEditTarget.targetKey === card.id) ||
                                      (activeManualEditTarget?.type === 'staging' && activeManualEditTarget.targetKey === card.slotRef);

                slot.className = `print-card-slot group ${isBeingEdited ? 'editing-active-ring' : ''}`;
                slot.style.width = `${card.widthMM}mm`;
                slot.style.height = `${card.heightMM}mm`;

                slot.innerHTML = `
                    <img src="${card.dataUrl}" alt="${card.label}">
                    
                    <!-- Hover Overlay Controls (Screen Only - Never Printed) -->
                    <div class="card-actions-overlay no-print absolute inset-0 bg-slate-900/65 backdrop-blur-[1px] flex flex-col items-center justify-center gap-2 p-2">
                        <span class="bg-slate-900/90 text-white text-[11px] font-bold px-2.5 py-0.5 rounded-full border border-slate-700">
                            #${index + 1} - ${card.label} (${card.widthMM}×${card.heightMM} مم)
                        </span>
                        <div class="flex flex-wrap items-center justify-center gap-1.5">
                            <button type="button" onclick="editA4CardCrop('${card.id}')" title="تعديل قص هذه البطاقة يدوياً" class="bg-amber-500 hover:bg-amber-400 text-slate-950 px-2.5 py-1.5 rounded-lg text-xs font-bold transition flex items-center gap-1 shadow">
                                <i class="fa-solid fa-pen-ruler"></i>
                                <span>تعديل القص</span>
                            </button>
                            <button type="button" onclick="duplicateA4Card('${card.id}')" title="تكرار البطاقة" class="bg-blue-600 hover:bg-blue-500 text-white px-2.5 py-1.5 rounded-lg text-xs font-bold transition flex items-center gap-1">
                                <i class="fa-solid fa-clone"></i>
                                <span>تكرار</span>
                            </button>
                            <button type="button" onclick="moveA4Card(${index}, -1)" title="تحريك لليمين" class="bg-slate-700 hover:bg-slate-600 text-white p-1.5 rounded-lg text-xs transition">
                                <i class="fa-solid fa-arrow-right"></i>
                            </button>
                            <button type="button" onclick="moveA4Card(${index}, 1)" title="تحريك لليسار" class="bg-slate-700 hover:bg-slate-600 text-white p-1.5 rounded-lg text-xs transition">
                                <i class="fa-solid fa-arrow-left"></i>
                            </button>
                            <button type="button" onclick="removeA4Card('${card.id}')" title="حذف من الورقة" class="bg-rose-600 hover:bg-rose-500 text-white px-2.5 py-1.5 rounded-lg text-xs font-bold transition flex items-center gap-1">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </div>
                    </div>
                `;
                grid.appendChild(slot);
            });
        }

        function updateA4LayoutStyles() {
            const gapMM = parseInt(document.getElementById('layout-gap-mm').value, 10);
            const topMM = parseInt(document.getElementById('layout-top-mm').value, 10);
            const showCutLines = document.getElementById('toggle-cut-lines').checked;
            const showBorder = document.getElementById('toggle-card-border').checked;
            const showGrid = document.getElementById('toggle-mm-grid').checked;

            document.getElementById('val-gap-mm').textContent = `${gapMM} مم`;
            document.getElementById('val-top-mm').textContent = `${topMM} مم`;

            const grid = document.getElementById('a4-cards-grid');
            grid.style.gap = `${gapMM}mm`;
            grid.style.paddingTop = `${topMM}mm`;

            const sheet = document.getElementById('a4-sheet');
            sheet.classList.toggle('cut-guides-dashed', showCutLines);
            sheet.classList.toggle('card-border-solid', showBorder);
            sheet.classList.toggle('show-mm-grid', showGrid);
        }

        function removeA4Card(cardId) {
            a4CardsList = a4CardsList.filter(c => c.id !== cardId);
            renderA4Sheet();
            showToast('تم حذف البطاقة من ورقة A4', 'info');
        }

        function duplicateA4Card(cardId) {
            const idx = a4CardsList.findIndex(c => c.id === cardId);
            if (idx === -1) return;
            const orig = a4CardsList[idx];
            const copy = {
                ...orig,
                id: 'card_' + Date.now() + '_' + Math.random().toString(36).slice(2, 6)
            };
            a4CardsList.splice(idx + 1, 0, copy);
            renderA4Sheet();
            showToast('تم تكرار البطاقة على الورقة', 'success');
        }

        function moveA4Card(index, direction) {
            const newIndex = index + direction;
            if (newIndex < 0 || newIndex >= a4CardsList.length) return;
            const temp = a4CardsList[index];
            a4CardsList[index] = a4CardsList[newIndex];
            a4CardsList[newIndex] = temp;
            renderA4Sheet();
        }

        function clearAllA4Cards() {
            if (a4CardsList.length === 0) return;
            a4CardsList = [];
            renderA4Sheet();
            showToast('تم إفراغ ورقة الطباعة A4 بالكامل', 'warning');
        }

        // ==========================================
        // 8. DIRECT PRINT & EXACT-MM 300-DPI PDF EXPORT
        // ==========================================
        function triggerDirectPrint() {
            if (a4CardsList.length === 0) {
                showToast('ورقة A4 فارغة! أضف بطاقة واحدة على الأقل قبل الطباعة.', 'warning');
                return;
            }
            window.print();
        }

        /**
         * Exports a true 300-DPI A4 PDF (210mm x 297mm) by placing each card at its exact
         * mathematical millimeter coordinates using jsPDF, ensuring 100% physical measurement accuracy.
         */
        async function exportHighResPDF() {
            if (a4CardsList.length === 0) {
                showToast('ورقة A4 فارغة! أضف بطاقة واحدة على الأقل قبل تصدير ملف PDF.', 'warning');
                return;
            }

            const btn = document.getElementById('btn-export-pdf');
            const originalHtml = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i><span>جاري تجهيز PDF...</span>`;

            try {
                const { jsPDF } = window.jspdf;
                const pdf = new jsPDF({
                    orientation: 'portrait',
                    unit: 'mm',
                    format: 'a4',
                    compress: true
                });

                const pageWidthMM = 210;
                const pageHeightMM = 297;
                const gapMM = parseFloat(document.getElementById('layout-gap-mm').value) || 4;
                const topMarginMM = parseFloat(document.getElementById('layout-top-mm').value) || 12;
                const showCutLines = document.getElementById('toggle-cut-lines').checked;
                const showBorder = document.getElementById('toggle-card-border').checked;

                // Layout cards in 2 columns (RTL: First card on Right, Second card on Left)
                let currentY = topMarginMM;
                let rowCards = [];
                let currentRowWidth = 0;
                const maxContentWidth = 186; // 210mm - 24mm side margins

                // Group cards into rows that fit within A4 width
                const rows = [];
                for (const card of a4CardsList) {
                    const neededWidth = rowCards.length === 0 ? card.widthMM : (currentRowWidth + gapMM + card.widthMM);
                    if (neededWidth <= maxContentWidth) {
                        rowCards.push(card);
                        currentRowWidth = neededWidth;
                    } else {
                        rows.push({ cards: rowCards, totalWidth: currentRowWidth });
                        rowCards = [card];
                        currentRowWidth = card.widthMM;
                    }
                }
                if (rowCards.length > 0) {
                    rows.push({ cards: rowCards, totalWidth: currentRowWidth });
                }

                // Draw each row centered horizontally, ordered Right-to-Left
                for (const row of rows) {
                    const rowMaxHeight = Math.max(...row.cards.map(c => c.heightMM));

                    // If row exceeds A4 bottom, add a new A4 page
                    if (currentY + rowMaxHeight > pageHeightMM - 8) {
                        pdf.addPage('a4', 'portrait');
                        currentY = topMarginMM;
                    }

                    // Start from the right edge of the centered row block (for RTL matching)
                    const rowRightEdgeX = (pageWidthMM + row.totalWidth) / 2;
                    let cursorRightX = rowRightEdgeX;

                    for (const card of row.cards) {
                        const cardX = cursorRightX - card.widthMM;
                        const cardY = currentY;

                        // Place High-Res 300 DPI Image at exact millimeter coordinates
                        pdf.addImage(card.dataUrl, 'JPEG', cardX, cardY, card.widthMM, card.heightMM);

                        // Optional Solid Card Border
                        if (showBorder) {
                            pdf.setDrawColor(148, 163, 184);
                            pdf.setLineWidth(0.2);
                            pdf.rect(cardX, cardY, card.widthMM, card.heightMM);
                        }

                        // Optional Dashed Cut Guide Lines
                        if (showCutLines) {
                            pdf.setDrawColor(100, 116, 139);
                            pdf.setLineWidth(0.25);
                            pdf.setLineDashPattern([1.5, 1.5], 0);
                            pdf.rect(cardX - 0.5, cardY - 0.5, card.widthMM + 1, card.heightMM + 1);
                            pdf.setLineDashPattern([], 0);
                        }

                        cursorRightX = cardX - gapMM;
                    }

                    currentY += rowMaxHeight + gapMM;
                }

                const timestamp = new Date().toISOString().slice(0, 10);
                pdf.save(`A4-ID-Cards-Print-${timestamp}.pdf`);
                showToast('تم تصدير ملف PDF بدقة 300 DPI وبالأبعاد القياسية بنجاح!', 'success');
            } catch (err) {
                console.error(err);
                showToast('حدث خطأ أثناء إنشاء ملف PDF، يرجى المحاولة مرة أخرى.', 'error');
            } finally {
                btn.disabled = false;
                btn.innerHTML = originalHtml;
            }
        }
    </script>
