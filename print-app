    <!-- Toast Notification Container (No alert() used) -->
    <div id="toast-container" class="no-print fixed bottom-5 left-5 z-50 flex flex-col gap-2 max-w-sm w-full pointer-events-none"></div>

    <!-- Main Application Script -->
    <script>
        // ==========================================
        // 1. APPLICATION STATE
        // ==========================================
        let cropper = null;
        let currentFlipX = 1;
        let currentFlipY = 1;
        let currentUploadedImgSrc = '';
        let currentImageElement = null; // Offscreen Image object for CV & Perspective Warp
        let editorMode = 'rect';        // 'rect' (Cropper.js) | 'perspective' (4-Point Homography)

        // Detected cards from Smart Computer Vision engine on current image
        // Each item: { bbox: {x,y,w,h}, corners: [{x,y}x4], isSkewed: boolean }
        let lastDetectedCards = [];

        // Active physical dimensions in millimeters (Default: CR80 85.6mm x 54mm)
        let activeCardSpec = {
            id: 'cr80_h',
            widthMM: 85.6,
            heightMM: 54.0,
            aspectRatio: 85.6 / 54.0
        };

        // Filter Settings State
        let filterState = {
            mode: 'color', // 'color' | 'grayscale' | 'photocopy'
            brightness: 100,
            contrast: 105,
            whiten: 0,
            sharpness: 20
        };

        // Staging Area State (Front & Back data URLs + dimensions + crop metadata for manual re-editing)
        let stagingCards = {
            front: null,
            back: null
        };

        // Array of Cards placed on the A4 Sheet
        // Each item: { id, slotRef, dataUrl, label, widthMM, heightMM, sourceMeta }
        let a4CardsList = [];

        // Live Manual Edit Tracking: { type: 'staging' | 'a4', targetKey: 'front' | 'back' | cardId }
        let activeManualEditTarget = null;

        // 4-Point Perspective Interactive State
        // Normalized coordinates (0..1) in image space: [TopLeft, TopRight, BottomRight, BottomLeft]
        let perspectiveCorners = [
            { x: 0.15, y: 0.15 },
            { x: 0.85, y: 0.15 },
            { x: 0.85, y: 0.85 },
            { x: 0.15, y: 0.85 }
        ];
        let draggingCornerIdx = -1;
        let perspectiveCanvasScale = 1;

        // ==========================================
        // 2. INITIALIZATION & RESPONSIVE A4 SCALING
        // ==========================================
        window.addEventListener('DOMContentLoaded', () => {
            adjustA4PreviewScale();
            window.addEventListener('resize', () => {
                adjustA4PreviewScale();
                if (editorMode === 'perspective' && currentImageElement) {
                    renderPerspectiveEditorCanvas();
                }
            });
            setupDragAndDropAndPaste();
            setupPerspectiveCanvasEvents();
            updateFilterSettings();

            // Load default dual-card scanner sheet and let Smart Auto-Detect capture both Front & Back automatically!
            loadDemoScenario('dual_scanner', true);
        });

        function adjustA4PreviewScale() {
            const viewport = document.getElementById('a4-viewport');
            if (!viewport) return;
            const availableWidth = viewport.clientWidth - 36;
            const a4PixelWidth = 794;
            let scale = availableWidth / a4PixelWidth;
            scale = Math.min(Math.max(scale, 0.36), 0.78);
            document.documentElement.style.setProperty('--a4-scale', scale.toFixed(3));
        }

        function showToast(message, type = 'success') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            
            const colors = {
                success: 'bg-slate-900 border-emerald-500 text-white',
                info: 'bg-slate-900 border-blue-500 text-white',
                warning: 'bg-amber-950 border-amber-500 text-amber-100',
                error: 'bg-rose-950 border-rose-500 text-rose-100'
            };
            const icons = {
                success: 'fa-circle-check text-emerald-400',
                info: 'fa-wand-magic-sparkles text-sky-400',
                warning: 'fa-triangle-exclamation text-amber-400',
                error: 'fa-circle-xmark text-rose-400'
            };

            toast.className = `pointer-events-auto flex items-center gap-3 px-4 py-3 rounded-xl border-r-4 shadow-xl text-xs font-bold transition-all duration-300 transform translate-y-2 opacity-0 ${colors[type] || colors.info}`;
            toast.innerHTML = `
                <i class="fa-solid ${icons[type] || icons.info} text-base"></i>
                <span class="flex-1 leading-relaxed">${message}</span>
            `;

            container.appendChild(toast);
            requestAnimationFrame(() => {
                toast.classList.remove('translate-y-2', 'opacity-0');
            });

            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-2');
                setTimeout(() => toast.remove(), 300);
            }, 4200);
        }

        // ==========================================
        // 3. SMART COMPUTER VISION ENGINE (AUTO-DETECT 1 OR 2 CARDS + CORNERS)
        // ==========================================
        /**
         * Analyzes an image locally on an offscreen canvas to automatically detect:
         * - Whether there are 1 or 2 separate ID cards (e.g. Front & Back on a scanner bed)
         * - Exact bounding boxes & 4 corner vertices of each card against the background
         */
        function detectIDCardsInImage(imgEl) {
            const analysisWidth = 360;
            const scale = analysisWidth / imgEl.naturalWidth;
            const analysisHeight = Math.max(120, Math.round(imgEl.naturalHeight * scale));

            const cvCanvas = document.createElement('canvas');
            cvCanvas.width = analysisWidth;
            cvCanvas.height = analysisHeight;
            const ctx = cvCanvas.getContext('2d');
            ctx.drawImage(imgEl, 0, 0, analysisWidth, analysisHeight);

            const imgData = ctx.getImageData(0, 0, analysisWidth, analysisHeight);
            const data = imgData.data;

            // Step 1: Estimate Background Color from border perimeter pixels
            let bgR = 0, bgG = 0, bgB = 0, borderSamples = 0;
            const step = 4;
            for (let x = 0; x < analysisWidth; x += step) {
                for (const y of [2, 5, analysisHeight - 3, analysisHeight - 6]) {
                    const idx = (y * analysisWidth + x) * 4;
                    bgR += data[idx]; bgG += data[idx + 1]; bgB += data[idx + 2];
                    borderSamples++;
                }
            }
            for (let y = 0; y < analysisHeight; y += step) {
                for (const x of [2, 5, analysisWidth - 3, analysisWidth - 6]) {
                    const idx = (y * analysisWidth + x) * 4;
                    bgR += data[idx]; bgG += data[idx + 1]; bgB += data[idx + 2];
                    borderSamples++;
                }
            }
            bgR /= borderSamples; bgG /= borderSamples; bgB /= borderSamples;

            // Step 2: Create Foreground Binary Mask using Color Distance + Local Edge Gradient
            const mask = new Uint8Array(analysisWidth * analysisHeight);
            for (let y = 2; y < analysisHeight - 2; y++) {
                for (let x = 2; x < analysisWidth - 2; x++) {
                    const idx = (y * analysisWidth + x) * 4;
                    const r = data[idx], g = data[idx + 1], b = data[idx + 2];

                    // Euclidean color difference from background
                    const colorDiff = Math.sqrt((r - bgR) ** 2 + (g - bgG) ** 2 + (b - bgB) ** 2);

                    // Local Sobel-like gradient to catch white cards on light scanner backgrounds
                    const idxRight = (y * analysisWidth + (x + 2)) * 4;
                    const idxDown = ((y + 2) * analysisWidth + x) * 4;
                    const gradX = Math.abs(r - data[idxRight]) + Math.abs(g - data[idxRight + 1]) + Math.abs(b - data[idxRight + 2]);
                    const gradY = Math.abs(r - data[idxDown]) + Math.abs(g - data[idxDown + 1]) + Math.abs(b - data[idxDown + 2]);
                    const edgeStrength = (gradX + gradY) / 3;

                    if (colorDiff > 24 || edgeStrength > 18) {
                        mask[y * analysisWidth + x] = 1;
                    }
                }
            }

            // Step 3: Morphological Closing (3x3 Dilation) to bridge internal card areas
            const closedMask = new Uint8Array(analysisWidth * analysisHeight);
            for (let y = 2; y < analysisHeight - 2; y++) {
                for (let x = 2; x < analysisWidth - 2; x++) {
                    let sum = 0;
                    for (let dy = -2; dy <= 2; dy++) {
                        for (let dx = -2; dx <= 2; dx++) {
                            sum += mask[(y + dy) * analysisWidth + (x + dx)];
                        }
                    }
                    if (sum >= 5) closedMask[y * analysisWidth + x] = 1;
                }
            }

            // Step 4: Connected Components Labeling (Flood Fill) to find distinct Card Blobs
            const visited = new Uint8Array(analysisWidth * analysisHeight);
            const components = [];
            const minCardPixels = (analysisWidth * analysisHeight) * 0.04; // At least 4% of image area

            for (let y = 4; y < analysisHeight - 4; y++) {
                for (let x = 4; x < analysisWidth - 4; x++) {
                    const startIdx = y * analysisWidth + x;
                    if (closedMask[startIdx] === 1 && !visited[startIdx]) {
                        const queue = [startIdx];
                        visited[startIdx] = 1;

                        let minX = x, maxX = x, minY = y, maxY = y;
                        let pixelCount = 0;

                        // Extremal corner candidates using diagonal projections:
                        // TL: min(x+y), TR: max(x-y), BR: max(x+y), BL: min(x-y)
                        let tlScore = Infinity, trScore = -Infinity, brScore = -Infinity, blScore = Infinity;
                        let tlPt = { x, y }, trPt = { x, y }, brPt = { x, y }, blPt = { x, y };

                        while (queue.length > 0) {
                            const curr = queue.pop();
                            const cy = Math.floor(curr / analysisWidth);
                            const cx = curr % analysisWidth;
                            pixelCount++;

                            if (cx < minX) minX = cx;
                            if (cx > maxX) maxX = cx;
                            if (cy < minY) minY = cy;
                            if (cy > maxY) maxY = cy;

                            // Update 4-corner extremal vertices
                            const sumXY = cx + cy;
                            const diffXY = cx - cy;
                            if (sumXY < tlScore) { tlScore = sumXY; tlPt = { x: cx, y: cy }; }
                            if (diffXY > trScore) { trScore = diffXY; trPt = { x: cx, y: cy }; }
                            if (sumXY > brScore) { brScore = sumXY; brPt = { x: cx, y: cy }; }
                            if (diffXY < blScore) { blScore = diffXY; blPt = { x: cx, y: cy }; }

                            // 4-neighbors
                            const neighbors = [
                                curr - 1, curr + 1,
                                curr - analysisWidth, curr + analysisWidth
                            ];
                            for (const n of neighbors) {
                                if (n >= 0 && n < visited.length && closedMask[n] === 1 && !visited[n]) {
                                    visited[n] = 1;
                                    queue.push(n);
                                }
                            }
                        }

                        const bw = maxX - minX;
                        const bh = maxY - minY;
                        if (pixelCount >= minCardPixels && bw > 35 && bh > 25) {
                            // Check if the polygon is noticeably tilted/skewed compared to axis-aligned box
                            const topSlope = Math.abs(trPt.y - tlPt.y) / Math.max(1, trPt.x - tlPt.x);
                            const leftSlope = Math.abs(blPt.x - tlPt.x) / Math.max(1, blPt.y - tlPt.y);
                            const isSkewed = (topSlope > 0.06 || leftSlope > 0.06);

                            components.push({
                                pixelCount,
                                bbox: {
                                    x: Math.max(0, (minX - 2) / scale),
                                    y: Math.max(0, (minY - 2) / scale),
                                    width: Math.min(imgEl.naturalWidth, (bw + 4) / scale),
                                    height: Math.min(imgEl.naturalHeight, (bh + 4) / scale)
                                },
                                cornersNorm: [
                                    { x: tlPt.x / analysisWidth, y: tlPt.y / analysisHeight },
                                    { x: trPt.x / analysisWidth, y: trPt.y / analysisHeight },
                                    { x: brPt.x / analysisWidth, y: brPt.y / analysisHeight },
                                    { x: blPt.x / analysisWidth, y: blPt.y / analysisHeight }
                                ],
                                centerX: (minX + maxX) / 2,
                                isSkewed
                            });
                        }
                    }
                }
            }

            // Sort largest valid components first, take up to 2 cards (Front & Back)
            components.sort((a, b) => b.pixelCount - a.pixelCount);
            let detected = components.slice(0, 2);

            // If 2 cards are found, sort them Right-to-Left (so Right card is Front #1, Left card is Back #2)
            if (detected.length === 2) {
                detected.sort((a, b) => b.centerX - a.centerX);
            }

            // Fallback if image is uniform or full-bleed
            if (detected.length === 0) {
                const padW = imgEl.naturalWidth * 0.08;
                const padH = imgEl.naturalHeight * 0.08;
                detected = [{
                    pixelCount: 1000,
                    bbox: {
                        x: padW,
                        y: padH,
                        width: imgEl.naturalWidth - padW * 2,
                        height: imgEl.naturalHeight - padH * 2
                    },
                    cornersNorm: [
                        { x: 0.08, y: 0.08 },
                        { x: 0.92, y: 0.08 },
                        { x: 0.92, y: 0.92 },
                        { x: 0.08, y: 0.92 }
                    ],
                    isSkewed: false
                }];
            }

            return detected;
        }

        // ==========================================
        // 4. UPLOAD, PASTE & SMART AUTO-CAPTURE WORKFLOW
        // ==========================================
        function setupDragAndDropAndPaste() {
            const dropzone = document.getElementById('cropper-dropzone');

            dropzone.addEventListener('dragover', (e) => {
                e.preventDefault();
                dropzone.classList.add('ring-4', 'ring-blue-500');
            });

            dropzone.addEventListener('dragleave', () => {
                dropzone.classList.remove('ring-4', 'ring-blue-500');
            });

            dropzone.addEventListener('drop', (e) => {
                e.preventDefault();
                dropzone.classList.remove('ring-4', 'ring-blue-500');
                if (e.dataTransfer.files && e.dataTransfer.files[0]) {
                    loadFileIntoCropper(e.dataTransfer.files[0]);
                }
            });

            window.addEventListener('paste', (e) => {
                const items = (e.clipboardData || e.originalEvent.clipboardData)?.items;
                if (!items) return;
                for (let item of items) {
                    if (item.type.indexOf('image') !== -1) {
                        const file = item.getAsFile();
                        loadFileIntoCropper(file);
                        break;
                    }
                }
            });
        }

        function handleImageUpload(event) {
            const file = event.target.files[0];
            if (file) {
                loadFileIntoCropper(file);
                event.target.value = ''; // Allow re-uploading same file
            }
        }

        function loadFileIntoCropper(file) {
            if (!file.type.startsWith('image/')) {
                showToast('يرجى اختيار ملف صورة صالح (JPG, PNG, WEBP)', 'error');
                return;
            }
            const reader = new FileReader();
            reader.onload = (e) => {
                cancelManualEditMode();
                loadNewImageWithSmartDetection(e.target.result, false);
            };
            reader.readAsDataURL(file);
        }

        /**
         * Loads an image, runs the Smart CV Detector, positions the crop box (or 4 perspective corners)
         * automatically, and if Auto-Capture is enabled, immediately crops & places the card(s) onto A4!
         */
        function loadNewImageWithSmartDetection(imgSrc, silent = false) {
            currentUploadedImgSrc = imgSrc;
            const emptyState = document.getElementById('empty-cropper-state');
            const laserOverlay = document.getElementById('scanner-laser-overlay');

            emptyState.classList.add('hidden');
            laserOverlay.classList.remove('hidden');

            const offscreenImg = new Image();
            offscreenImg.onload = () => {
                currentImageElement = offscreenImg;

                // Run Smart Computer Vision Detection
                lastDetectedCards = detectIDCardsInImage(offscreenImg);
                const pillContainer = document.getElementById('detected-boxes-pills');
                const statusPill = document.getElementById('smart-status-pill');
                const summaryText = document.getElementById('detection-summary-text');

                if (lastDetectedCards.length >= 2) {
                    pillContainer.classList.remove('hidden');
                    pillContainer.classList.add('flex');
                    statusPill.textContent = 'تم اكتشاف بطاقتين (وجه + ظهر)';
                    summaryText.textContent = 'تم التعرف الذكي على بطاقتين في نفس الصورة! يمكنك التبديل بينهما أو تعديل أي بطاقة يدوياً.';
                } else {
                    pillContainer.classList.add('hidden');
                    pillContainer.classList.remove('flex');
                    statusPill.textContent = lastDetectedCards[0]?.isSkewed ? 'تم اكتشاف بطاقة مائلة (4 زوايا)' : 'تم اكتشاف البطاقة تلقائياً';
                    summaryText.textContent = 'تم تحديد حواف البطاقة تلقائياً — يمكنك تحريك الإطار أو الزوايا للتعديل اليدوي السريع.';
                }

                // Initialize 4-point corners from first detected card
                if (lastDetectedCards[0] && lastDetectedCards[0].cornersNorm) {
                    perspectiveCorners = JSON.parse(JSON.stringify(lastDetectedCards[0].cornersNorm));
                }

                // Automatically switch to 4-point Perspective mode if a skewed mobile photo is detected
                if (lastDetectedCards.length === 1 && lastDetectedCards[0].isSkewed) {
                    switchEditorMode('perspective', true);
                } else {
                    switchEditorMode('rect', true);
                }

                // Initialize Cropper.js on the image
                initCropperInstance(imgSrc, () => {
                    setTimeout(() => {
                        laserOverlay.classList.add('hidden');
                    }, 260);

                    // Position Cropper on the first detected card
                    if (lastDetectedCards[0] && cropper) {
                        applyImageBBoxToCropper(lastDetectedCards[0].bbox);
                    }

                    // Perform Instant Auto-Capture if enabled
                    const autoCaptureEnabled = document.getElementById('toggle-auto-capture').checked;
                    if (autoCaptureEnabled) {
                        performSmartAutoCapture(silent);
                    } else if (!silent) {
                        showToast('تم تحديد حواف البطاقة ذكياً! اضغط التحديث أو الإضافة عند الجاهزية.', 'info');
                    }
                });
            };
            offscreenImg.src = imgSrc;
        }

        function initCropperInstance(imgSrc, onReadyCallback) {
            const imgElement = document.getElementById('cropper-image');
            if (cropper) {
                cropper.destroy();
                cropper = null;
            }

            currentFlipX = 1;
            currentFlipY = 1;
            document.getElementById('fine-rotate-slider').value = 0;
            document.getElementById('fine-rotate-val').textContent = '0.0°';

            imgElement.src = imgSrc;
            imgElement.onload = () => {
                cropper = new Cropper(imgElement, {
                    aspectRatio: activeCardSpec.aspectRatio,
                    viewMode: 1,
                    dragMode: 'move',
                    autoCropArea: 0.85,
                    restore: false,
                    guides: true,
                    center: true,
                    highlight: true,
                    cropBoxMovable: true,
                    cropBoxResizable: true,
                    toggleDragModeOnDblclick: true,
                    ready() {
                        if (onReadyCallback) onReadyCallback();
                    },
                    cropend() {
                        // Live sync if user is manually adjusting an already captured card!
                        if (activeManualEditTarget) {
                            syncActiveManualEditLive();
                        }
                    }
                });
            };
        }

        /**
         * Positions Cropper.js crop box directly onto a bounding box in natural image coordinates
         */
        function applyImageBBoxToCropper(bbox) {
            if (!cropper || !bbox) return;
            cropper.setData({
                x: bbox.x,
                y: bbox.y,
                width: bbox.width,
                height: bbox.height,
                rotate: 0,
                scaleX: 1,
                scaleY: 1
            });
        }

        function focusDetectedCard(index) {
            if (!lastDetectedCards[index]) return;
            const det = lastDetectedCards[index];
            perspectiveCorners = JSON.parse(JSON.stringify(det.cornersNorm));
            if (editorMode === 'perspective') {
                renderPerspectiveEditorCanvas();
            } else if (cropper) {
                applyImageBBoxToCropper(det.bbox);
            }
            const label = index === 0 ? 'البطاقة الأولى (الوجه)' : 'البطاقة الثانية (الظهر)';
            showToast(`تم توجيه إطار القص إلى ${label}`, 'info');
        }

        function runSmartDetectionOnCurrentImage(forceCapture = false) {
            if (!currentImageElement) {
                showToast('يرجى رفع صورة مستمسك أولاً!', 'warning');
                return;
            }
            lastDetectedCards = detectIDCardsInImage(currentImageElement);
            if (lastDetectedCards[0]) {
                perspectiveCorners = JSON.parse(JSON.stringify(lastDetectedCards[0].cornersNorm));
                if (editorMode === 'perspective') {
                    renderPerspectiveEditorCanvas();
                } else if (cropper) {
                    applyImageBBoxToCropper(lastDetectedCards[0].bbox);
                }
            }
            if (forceCapture) {
                performSmartAutoCapture(false);
            }
        }

        /**
         * Automatically crops 1 or 2 detected cards, places them into Front/Back staging slots,
         * and adds them directly onto the A4 print sheet with full metadata for later manual editing!
         */
        function performSmartAutoCapture(silent = false) {
            if (!currentImageElement) return;

            // CASE A: 2 Separate Cards Detected in the Same Scan (e.g. Front & Back together)
            if (lastDetectedCards.length >= 2) {
                const card1Res = extractCardFromBBoxOrCorners({
                    mode: 'rect',
                    bbox: lastDetectedCards[0].bbox,
                    corners: lastDetectedCards[0].cornersNorm
                });
                const card2Res = extractCardFromBBoxOrCorners({
                    mode: 'rect',
                    bbox: lastDetectedCards[1].bbox,
                    corners: lastDetectedCards[1].cornersNorm
                });

                if (card1Res && card2Res) {
                    setStagingSlotData('front', card1Res);
                    setStagingSlotData('back', card2Res);

                    // Replace or add to A4 sheet automatically
                    syncStagingSlotToA4('front', true);
                    syncStagingSlotToA4('back', true);

                    if (!silent) {
                        showToast('تم اكتشاف (الوجه والظهر) معاً وقصهما تلقائياً إلى ورقة A4! يمكنك الضغط على "تعديل القص يدوياً" لأي بطاقة لتصحيحها.', 'success');
                    } else {
                        showToast('تم الفحص والقص الذكي التلقائي للوجه والظهر! جرب التعديل اليدوي أو ارفع مستمسكك.', 'info');
                    }
                }
                return;
            }

            // CASE B: 1 Single Card Detected (Skewed Perspective or Standard Rect)
            const det = lastDetectedCards[0];
            const useMode = det.isSkewed ? 'perspective' : editorMode;
            const extracted = extractCardFromBBoxOrCorners({
                mode: useMode,
                bbox: det.bbox,
                corners: det.cornersNorm
            });

            if (!extracted) return;

            // Decide target slot: if Front is empty, put in Front; if Front is filled and Back is empty, put in Back; otherwise update Front
            let targetSlot = 'front';
            if (stagingCards.front && !stagingCards.back) {
                targetSlot = 'back';
            }

            setStagingSlotData(targetSlot, extracted);
            syncStagingSlotToA4(targetSlot, true);

            const slotNameAr = targetSlot === 'front' ? 'وجه البطاقة' : 'ظهر البطاقة';
            if (!silent) {
                showToast(`تم القص الذكي التلقائي وإضافته كـ (${slotNameAr}) في ورقة A4! اضغط "تعديل القص يدوياً" إذا رغبت بضبط الحواف.`, 'success');
            }
        }

        // ==========================================
        // 5. DUAL EDITOR MODES: RECT CROPPER VS 4-POINT PERSPECTIVE WARP + LOUPE
        // ==========================================
        function switchEditorMode(mode, skipRedraw = false) {
            editorMode = mode;
            const btnRect = document.getElementById('btn-mode-rect');
            const btnPersp = document.getElementById('btn-mode-perspective');
            const perspContainer = document.getElementById('perspective-editor-container');
