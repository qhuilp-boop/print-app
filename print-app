        function renderPerspectiveEditorCanvas() {
            if (!currentImageElement) return;
            const container = document.getElementById('perspective-editor-container');
            const canvas = document.getElementById('perspective-canvas');
            const ctx = canvas.getContext('2d');

            const maxW = Math.max(320, container.clientWidth - 24);
            const maxH = Math.max(260, container.clientHeight - 24);

            const scale = Math.min(maxW / currentImageElement.naturalWidth, maxH / currentImageElement.naturalHeight);
            perspectiveCanvasScale = scale;

            canvas.width = Math.round(currentImageElement.naturalWidth * scale);
            canvas.height = Math.round(currentImageElement.naturalHeight * scale);

            ctx.clearRect(0, 0, canvas.width, canvas.height);
            ctx.drawImage(currentImageElement, 0, 0, canvas.width, canvas.height);

            // Convert normalized corners to canvas coordinates
            const pts = perspectiveCorners.map(p => ({
                x: p.x * canvas.width,
                y: p.y * canvas.height
            }));

            // Darken outside polygon
            ctx.save();
            ctx.fillStyle = 'rgba(15, 23, 42, 0.55)';
            ctx.beginPath();
            ctx.rect(0, 0, canvas.width, canvas.height);
            ctx.moveTo(pts[0].x, pts[0].y);
            ctx.lineTo(pts[1].x, pts[1].y);
            ctx.lineTo(pts[2].x, pts[2].y);
            ctx.lineTo(pts[3].x, pts[3].y);
            ctx.closePath();
            ctx.fill('evenodd');
            ctx.restore();

            // Draw perspective quad border & internal grid lines
            ctx.save();
            ctx.strokeStyle = '#38bdf8';
            ctx.lineWidth = 2.5;
            ctx.beginPath();
            ctx.moveTo(pts[0].x, pts[0].y);
            ctx.lineTo(pts[1].x, pts[1].y);
            ctx.lineTo(pts[2].x, pts[2].y);
            ctx.lineTo(pts[3].x, pts[3].y);
            ctx.closePath();
            ctx.stroke();

            // Subtle rule-of-thirds grid inside quad
            ctx.strokeStyle = 'rgba(56, 189, 248, 0.35)';
            ctx.lineWidth = 1;
            ctx.setLineDash([4, 4]);
            for (let t of [0.333, 0.666]) {
                const topX = pts[0].x + (pts[1].x - pts[0].x) * t;
                const topY = pts[0].y + (pts[1].y - pts[0].y) * t;
                const botX = pts[3].x + (pts[2].x - pts[3].x) * t;
                const botY = pts[3].y + (pts[2].y - pts[3].y) * t;
                ctx.beginPath(); ctx.moveTo(topX, topY); ctx.lineTo(botX, botY); ctx.stroke();

                const leftX = pts[0].x + (pts[3].x - pts[0].x) * t;
                const leftY = pts[0].y + (pts[3].y - pts[0].y) * t;
                const rightX = pts[1].x + (pts[2].x - pts[1].x) * t;
                const rightY = pts[1].y + (pts[2].y - pts[1].y) * t;
                ctx.beginPath(); ctx.moveTo(leftX, leftY); ctx.lineTo(rightX, rightY); ctx.stroke();
            }
            ctx.restore();

            // Draw the 4 Corner Handles
            const cornerLabels = ['أعلى يسار', 'أعلى يمين', 'أسفل يمين', 'أسفل يسار'];
            pts.forEach((pt, idx) => {
                ctx.save();
                // Outer Halo
                ctx.beginPath();
                ctx.arc(pt.x, pt.y, 12, 0, Math.PI * 2);
                ctx.fillStyle = idx === draggingCornerIdx ? 'rgba(245, 158, 11, 0.45)' : 'rgba(37, 99, 235, 0.35)';
                ctx.fill();

                // Main Handle Circle
                ctx.beginPath();
                ctx.arc(pt.x, pt.y, 7, 0, Math.PI * 2);
                ctx.fillStyle = idx === draggingCornerIdx ? '#f59e0b' : '#ffffff';
                ctx.fill();
                ctx.lineWidth = 2.5;
                ctx.strokeStyle = '#1d4ed8';
                ctx.stroke();

                // Center precision dot
                ctx.beginPath();
                ctx.arc(pt.x, pt.y, 2, 0, Math.PI * 2);
                ctx.fillStyle = '#0f172a';
                ctx.fill();
                ctx.restore();
            });
        }

        function setupPerspectiveCanvasEvents() {
            const canvas = document.getElementById('perspective-canvas');
            const loupe = document.getElementById('perspective-loupe');

            function getPointerPos(e) {
                const rect = canvas.getBoundingClientRect();
                const clientX = e.touches ? e.touches[0].clientX : e.clientX;
                const clientY = e.touches ? e.touches[0].clientY : e.clientY;
                return {
                    x: clientX - rect.left,
                    y: clientY - rect.top
                };
            }

            function onPointerDown(e) {
                if (editorMode !== 'perspective' || !currentImageElement) return;
                const pos = getPointerPos(e);
                let bestIdx = -1;
                let minDist = 28; // Grab radius in pixels

                perspectiveCorners.forEach((c, idx) => {
                    const cx = c.x * canvas.width;
                    const cy = c.y * canvas.height;
                    const dist = Math.hypot(pos.x - cx, pos.y - cy);
                    if (dist < minDist) {
                        minDist = dist;
                        bestIdx = idx;
                    }
                });

                if (bestIdx !== -1) {
                    e.preventDefault();
                    draggingCornerIdx = bestIdx;
                    updatePerspectiveLoupe(pos.x, pos.y, bestIdx);
                    renderPerspectiveEditorCanvas();
                }
            }

            function onPointerMove(e) {
                if (draggingCornerIdx === -1 || editorMode !== 'perspective') return;
                e.preventDefault();
                const pos = getPointerPos(e);
                const normX = Math.min(0.99, Math.max(0.01, pos.x / canvas.width));
                const normY = Math.min(0.99, Math.max(0.01, pos.y / canvas.height));

                perspectiveCorners[draggingCornerIdx] = { x: normX, y: normY };
                renderPerspectiveEditorCanvas();
                updatePerspectiveLoupe(normX * canvas.width, normY * canvas.height, draggingCornerIdx);
            }

            function onPointerUp() {
                if (draggingCornerIdx !== -1) {
                    draggingCornerIdx = -1;
                    loupe.classList.add('hidden');
                    renderPerspectiveEditorCanvas();
                    // Live sync to captured card!
                    if (activeManualEditTarget) {
                        syncActiveManualEditLive();
                    }
                }
            }

            canvas.addEventListener('mousedown', onPointerDown);
            window.addEventListener('mousemove', onPointerMove);
            window.addEventListener('mouseup', onPointerUp);

            canvas.addEventListener('touchstart', onPointerDown, { passive: false });
            window.addEventListener('touchmove', onPointerMove, { passive: false });
            window.addEventListener('touchend', onPointerUp);
        }

        function updatePerspectiveLoupe(canvasX, canvasY, cornerIdx) {
            if (!currentImageElement) return;
            const loupe = document.getElementById('perspective-loupe');
            const loupeCanvas = document.getElementById('loupe-canvas');
            const lCtx = loupeCanvas.getContext('2d');
            const labelEl = document.getElementById('loupe-corner-label');
            const names = ['زاوية أعلى اليسار', 'زاوية أعلى اليمين', 'زاوية أسفل اليمين', 'زاوية أسفل اليسار'];

            loupe.classList.remove('hidden');
            labelEl.textContent = names[cornerIdx] || 'الزاوية';

            // Move loupe to opposite side if pointer is in top-left corner
            if (canvasX < 150 && canvasY < 150) {
                loupe.style.left = 'auto';
                loupe.style.right = '12px';
            } else {
                loupe.style.right = 'auto';
                loupe.style.left = '12px';
            }

            const imgX = canvasX / perspectiveCanvasScale;
            const imgY = canvasY / perspectiveCanvasScale;
            const zoomRadius = 32; // Source pixels around corner

            lCtx.fillStyle = '#0f172a';
            lCtx.fillRect(0, 0, 128, 128);
            lCtx.drawImage(
                currentImageElement,
                imgX - zoomRadius, imgY - zoomRadius, zoomRadius * 2, zoomRadius * 2,
                0, 0, 128, 128
            );
        }

        /**
         * Performs 4-Point Perspective Homography / Bilinear Rectification onto a 300 DPI target canvas
         */
        function warpPerspectiveFrom4Corners(imgEl, cornersNorm, targetW, targetH) {
            const srcCanvas = document.createElement('canvas');
            srcCanvas.width = imgEl.naturalWidth;
            srcCanvas.height = imgEl.naturalHeight;
            const sCtx = srcCanvas.getContext('2d');
            sCtx.drawImage(imgEl, 0, 0);
            const srcData = sCtx.getImageData(0, 0, srcCanvas.width, srcCanvas.height).data;

            const dstCanvas = document.createElement('canvas');
            dstCanvas.width = targetW;
            dstCanvas.height = targetH;
            const dCtx = dstCanvas.getContext('2d');
            const dstImgData = dCtx.createImageData(targetW, targetH);
            const dstData = dstImgData.data;

            const sw = srcCanvas.width;
            const sh = srcCanvas.height;
            const p0 = { x: cornersNorm[0].x * sw, y: cornersNorm[0].y * sh }; // TL
            const p1 = { x: cornersNorm[1].x * sw, y: cornersNorm[1].y * sh }; // TR
            const p2 = { x: cornersNorm[2].x * sw, y: cornersNorm[2].y * sh }; // BR
            const p3 = { x: cornersNorm[3].x * sw, y: cornersNorm[3].y * sh }; // BL

            for (let y = 0; y < targetH; y++) {
                const v = y / (targetH - 1);
                const topX = p0.x + (p1.x - p0.x) * 0;
                for (let x = 0; x < targetW; x++) {
                    const u = x / (targetW - 1);
                    // Bilinear interpolation in projective quad
                    const sx = (1 - u) * (1 - v) * p0.x + u * (1 - v) * p1.x + u * v * p2.x + (1 - u) * v * p3.x;
                    const sy = (1 - u) * (1 - v) * p0.y + u * (1 - v) * p1.y + u * v * p2.y + (1 - u) * v * p3.y;

                    const ix = Math.min(sw - 1, Math.max(0, Math.round(sx)));
                    const iy = Math.min(sh - 1, Math.max(0, Math.round(sy)));
                    const sIdx = (iy * sw + ix) * 4;
                    const dIdx = (y * targetW + x) * 4;

                    dstData[dIdx] = srcData[sIdx];
                    dstData[dIdx + 1] = srcData[sIdx + 1];
                    dstData[dIdx + 2] = srcData[sIdx + 2];
                    dstData[dIdx + 3] = 255;
                }
            }
            dCtx.putImageData(dstImgData, 0, 0);
            return dstCanvas;
        }

