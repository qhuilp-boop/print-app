    <style>
        body {
            font-family: 'Cairo', sans-serif;
            background-color: #f1f5f9;
            color: #0f172a;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #e2e8f0;
        }
        ::-webkit-scrollbar-thumb {
            background: #94a3b8;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #64748b;
        }

        /* Cropper Container Styling */
        .cropper-wrapper {
            height: 410px;
            background-color: #0f172a;
            background-image: radial-gradient(#334155 1px, transparent 1px);
            background-size: 16px 16px;
            position: relative;
            overflow: hidden;
        }

        /* Visual Filter Preview on Cropper Canvas */
        .cropper-wrapper.filter-preview-active .cropper-canvas,
        .cropper-wrapper.filter-preview-active .cropper-view-box img {
            filter: var(--live-crop-filter, none);
        }

        /* 4-Point Perspective Canvas Styling */
        #perspective-canvas {
            max-width: 100%;
            max-height: 100%;
            cursor: crosshair;
            touch-action: none;
            filter: var(--live-crop-filter, none);
        }

        /* Active Editing Card Pulse Ring */
        .editing-active-ring {
            outline: 3px solid #f59e0b !important;
            outline-offset: 2px !important;
            box-shadow: 0 0 0 4px rgba(245, 158, 11, 0.35) !important;
        }

        /* Scanning Laser Animation */
        @keyframes scanLaser {
            0% { top: 0%; opacity: 0.9; }
            50% { top: 96%; opacity: 1; }
            100% { top: 0%; opacity: 0.9; }
        }
        .laser-line {
            position: absolute;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, transparent, #38bdf8, #2563eb, #38bdf8, transparent);
            box-shadow: 0 0 15px 3px rgba(56, 189, 248, 0.8);
            animation: scanLaser 1.2s ease-in-out infinite;
            z-index: 30;
            pointer-events: none;
        }

        /* A4 Paper Screen Simulation & Exact Print Sizing */
        :root {
            --a4-scale: 0.72;
        }

        .a4-viewport-wrapper {
            display: flex;
            justify-content: center;
            align-items: flex-start;
            padding: 1.5rem;
            overflow: auto;
            background: repeating-linear-gradient(
                45deg,
                #e2e8f0,
                #e2e8f0 10px,
                #cbd5e1 10px,
                #cbd5e1 20px
            );
            border-radius: 0.75rem;
            min-height: 680px;
        }

        .a4-scale-container {
            width: calc(210mm * var(--a4-scale));
            height: calc(297mm * var(--a4-scale));
            position: relative;
            transition: width 0.2s ease, height 0.2s ease;
        }

        /* Actual 210mm x 297mm Sheet */
        #a4-sheet {
            width: 210mm;
            height: 297mm;
            background: #ffffff;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
            transform: scale(var(--a4-scale));
            transform-origin: top right;
            position: relative;
            box-sizing: border-box;
            overflow: hidden;
        }

        /* Millimeter Grid Overlay (Screen Only) */
        #a4-sheet.show-mm-grid {
            background-image: 
                linear-gradient(to right, rgba(59, 130, 246, 0.08) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(59, 130, 246, 0.08) 1px, transparent 1px);
            background-size: 10mm 10mm;
        }

        /* Individual Card Item on A4 */
        .print-card-slot {
            position: relative;
            box-sizing: border-box;
            background-color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            transition: box-shadow 0.15s ease;
        }

        .print-card-slot img {
            width: 100%;
            height: 100%;
            object-fit: fill;
            display: block;
            user-select: none;
            -webkit-user-drag: none;
        }

        /* Cut Guide Lines */
        .cut-guides-dashed .print-card-slot {
            outline: 0.35mm dashed #64748b;
            outline-offset: 0.4mm;
        }

        .card-border-solid .print-card-slot {
            border: 0.25mm solid #94a3b8;
        }

        /* Hover Controls on A4 Card (Hidden in Print) */
        .print-card-slot .card-actions-overlay {
            opacity: 0;
            transition: opacity 0.15s ease;
        }
        .print-card-slot:hover .card-actions-overlay {
            opacity: 1;
        }

        /* STRICT PRINT MEDIA RULES - 100% Exact Physical Millimeters */
        @media print {
            @page {
                size: A4 portrait;
                margin: 0mm !important;
            }

            html, body {
                width: 210mm !important;
                height: 297mm !important;
                margin: 0 !important;
                padding: 0 !important;
                background: #ffffff !important;
                overflow: hidden !important;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }

            /* Hide everything except the A4 Sheet */
            .no-print {
                display: none !important;
            }

            .a4-viewport-wrapper,
            .a4-scale-container,
            main,
            #app-layout {
                padding: 0 !important;
                margin: 0 !important;
                width: 210mm !important;
                height: 297mm !important;
                background: transparent !important;
                display: block !important;
                overflow: visible !important;
            }

            #a4-sheet {
                width: 210mm !important;
                height: 297mm !important;
                transform: none !important;
                box-shadow: none !important;
                margin: 0 !important;
                border: none !important;
                background-image: none !important;
                page-break-after: avoid;
                page-break-inside: avoid;
            }

            .card-actions-overlay,
            .screen-only-badge {
                display: none !important;
            }
        }
    </style>
</head>
